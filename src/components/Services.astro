---
import { Image } from 'astro:assets'
import { ArrowUpRight } from 'lucide-react'

import { services } from '@/data/site'
import { fitWidths } from '@/lib/images'
---

<section id="servicios" class="services section-pad dark-section">
  <div class="container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">02 / NUESTROS SERVICIOS</p>
        <h2 class="display-title">El arte de <em>cuidarte.</em></h2>
      </div>
      <p class="body-copy heading-copy">
        Técnica, sensibilidad y productos que respetan tu esencia.
      </p>
    </div>

    <div class="service-grid">
      {
        services.map((service, i) => (
          <div class="service-card-wrap">
            <div class="service-gallery">
            {service.images.map((image, n) => (
              <button
                type="button"
                class="service-gallery-item"
                data-reveal
                style={`--reveal-delay:${i * 140 + n * 90}ms`}
                data-service-trigger={`${i}-${n}`}
                aria-label={`Ver ${service.title}, foto ${n + 1} de ${service.images.length}`}
              >
                <Image
                  src={image}
                  alt={`${service.title} — foto ${n + 1}`}
                  widths={fitWidths([240, 390, 585, 780], image.width)}
                  sizes={n < 2 ? '(max-width: 700px) 48vw, 26vw' : '(max-width: 700px) 32vw, 16vw'}
                  format="webp"
                  quality={72}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            ))}
          </div>
          <div class="service-info" data-reveal style={`--reveal-delay:${i * 140 + 440}ms`}>
            <div>
              <span>{service.label}</span>
              <h3>{service.title}</h3>
            </div>
            <span class="round-arrow">
              <ArrowUpRight size={18} />
</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
