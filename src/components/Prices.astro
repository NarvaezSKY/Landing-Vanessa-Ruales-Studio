---
import { ArrowUpRight, X } from 'lucide-react'

import { prices } from '@/data/site'

/* The section is a teaser: seven rows per category, and the dialog below carries
   the whole catalogue. Bump this to show more inline. */
const PREVIEW_COUNT = 7

const totalItems = prices.reduce((sum, group) => sum + group.items.length, 0)
---

<section id="precios" class="price-section section-pad">
  <div class="container price-grid">
    <div data-reveal>
      <p class="eyebrow">03 / INVERSIÓN</p>
      <h2 class="display-title">Tu tiempo es<br /><em>valioso.</em></h2>
      <p class="body-copy">
        Precios transparentes para experiencias hechas a tu medida. Para servicios personalizados,
        escríbenos.
      </p>
      <a href="#citas" class="text-link">
        Consultar disponibilidad <ArrowUpRight size={16} />
      </a>
    </div>

    <div class="price-list" data-reveal style="--reveal-delay:160ms">
      {
        prices.map((group) => (
          <div class="price-group">
            <h3 class="price-group__title">
              <span aria-hidden="true">{group.icon}</span>
              {group.label}
            </h3>
            {group.items.slice(0, PREVIEW_COUNT).map(([name, value]) => (
              <div class="price-row">
                <span>{name}</span>
                <strong><span class="price-row__from">Desde</span>{value}</strong>
              </div>
            ))}
          </div>
        ))
      }
      <button
        type="button"
        class="price-more"
        data-service-trigger="catalogo"
        aria-haspopup="dialog"
        aria-label={`Ver la lista completa de ${totalItems} servicios`}
      >
        Ver lista completa ({totalItems} servicios) <ArrowUpRight size={16} />
      </button>
      <p class="price-note">
        * Precios en pesos colombianos (COP). Pueden variar según largo, volumen y diagnóstico.
      </p>
    </div>
  </div>
</section>

{/* Reuses the service-dialog machinery in index.astro: the script keys off
    [data-service-modal] / [data-service-trigger], so Escape, the focus trap,
    the body scroll lock and the particle pause all apply unchanged. */}
<div
  class="modal-backdrop"
  data-service-modal="catalogo"
  role="dialog"
  aria-modal="true"
  aria-label="Lista completa de precios"
  hidden
>
  <div class="modal-card modal-card--catalogo">
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">
      <X />
    </button>
    <div class="modal-content modal-content--catalogo">
      <p class="eyebrow">Tarifario completo</p>
      <h2>Todos los servicios</h2>
      <div class="catalogo-scroll" data-modal-scroll>
        <div class="price-list">
          {
            prices.map((group) => (
              <div class="price-group">
                <h3 class="price-group__title">
                  <span aria-hidden="true">{group.icon}</span>
                  {group.label}
                </h3>
                {group.items.map(([name, value]) => (
                  <div class="price-row">
                    <span>{name}</span>
                    <strong><span class="price-row__from">Desde</span>{value}</strong>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </div>
      <p class="price-note">
        * Precios en pesos colombianos (COP). Pueden variar según largo, volumen y diagnóstico.
      </p>
      <a href="#citas" class="button button-gold" data-modal-close>
        Agendar <ArrowUpRight size={17} />
      </a>
    </div>
  </div>
</div>

<style>
  /* .modal-backdrop sets display:grid, which would otherwise beat the UA rule
     for the `hidden` attribute and leave this dialog permanently visible. The
     sibling rule lives in ServiceModal.astro, scoped to that component only. */
  .modal-backdrop[hidden] {
    display: none;
  }

  /* Two classes on purpose: the base `.modal-card` / `.modal-content` rules live
     in global.css, and a single-class scoped rule cannot be relied on to win
     against them. The card has to be a flex column, otherwise it is a block
     box that never shrinks its children -- the catalogue would overflow and get
     clipped instead of scrolling. */
  .modal-card.modal-card--catalogo {
    display: flex;
    flex-direction: column;
    width: min(880px, 100%);
    max-height: min(86vh, 880px);
  }

  .modal-content.modal-content--catalogo {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    padding: 44px 48px;
  }

  .modal-content--catalogo h2 {
    font-size: clamp(34px, 4.4vw, 46px);
    margin: 0 0 4px;
  }

  /* flex:1 + min-height:0 is what lets this shrink below its content height and
     become the scroll container. */
  .catalogo-scroll {
    flex: 1 1 auto;
    min-height: 0;
    margin: 18px -10px 0 0;
    padding-right: 10px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }

  .catalogo-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .catalogo-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .catalogo-scroll::-webkit-scrollbar-thumb {
    background: var(--gold);
    border-radius: 3px;
  }

  .catalogo-scroll .price-list {
    align-self: stretch;
    gap: 34px 44px;
  }

  .catalogo-scroll .price-row {
    padding: 9px 0;
  }

  @media (max-width: 700px) {
    .modal-card.modal-card--catalogo {
      max-height: 92vh;
    }

    .modal-content.modal-content--catalogo {
      padding: 30px 24px;
    }

    .catalogo-scroll {
      margin-right: 0;
      padding-right: 6px;
    }
  }
</style>