---
import Layout from '@/layouts/Layout.astro'

import About from '@/components/About.astro'
import Booking from '@/components/Booking.astro'
import Footer from '@/components/Footer.astro'
import Hero from '@/components/Hero.astro'
import Intro from '@/components/Intro.astro'
import IntroLogo from '@/components/IntroLogo.astro'
import Location from '@/components/Location.astro'
import Nav from '@/components/Nav.astro'
import Prices from '@/components/Prices.astro'
import ServiceModal from '@/components/ServiceModal.astro'
import Services from '@/components/Services.astro'
---

<Layout
  title="Vanessa Ruales Studio | Salón de Belleza en Popayán"
  description="Vanessa Ruales Studio — salón de belleza en Popayán, Cauca. Manicure, semipermanente, poly gel, keratina, facial, depilación, pestañas y maquillaje."
>
  <main class="site-shell">
    <Nav />
    <Hero />
    <Intro />
    <Services />
    <Prices />
    <About />
    <Location />
    <Booking />
    <Footer />
    <ServiceModal />
  </main>

  <IntroLogo />

  <!-- Decorative motes in the page gutters. pointer-events:none, and it stops
       itself under prefers-reduced-motion. -->
  <canvas data-particles aria-hidden="true"></canvas>

  <script src="../scripts/hero-rotator.ts"></script>
  <script src="../scripts/reveal.ts"></script>
  <script src="../scripts/particles.ts"></script>

  <script>
    // The page is static HTML; these are the only two interactive pieces and
    // neither needs a component framework, so nothing here ships React.

    // --- Logo intro ------------------------------------------------------
    // The overlay paints itself from CSS keyed on html.intro-pending. This only
    // tears it down: the timer guarantees the node leaves the DOM so it can
    // never keep intercepting clicks, and any deliberate input skips the rest.
    // Keep INTRO_MS in sync with the `animation` durations in IntroLogo.astro.
    const INTRO_MS = 1800
    const intro = document.querySelector<HTMLElement>('[data-intro]')

    if (intro) {
      const dismissIntro = () => {
        document.documentElement.classList.remove('intro-pending', 'intro-forced')
        intro.remove()
      }

      const introTimer = window.setTimeout(dismissIntro, INTRO_MS)
      for (const type of ['pointerdown', 'keydown', 'wheel']) {
        window.addEventListener(type, dismissIntro, {
          once: true,
          passive: true,
        })
      }
      window.addEventListener('pagehide', () => window.clearTimeout(introTimer))
    }

    // --- Sticky glass nav --------------------------------------------------
    // The nav is absolutely positioned over the hero so it scrolls away with it.
    // Once the hero is fully past the fold it has to stay reachable, so it
    // becomes fixed and grows the liquid-glass pill. Observing the hero (instead
    // of listening to scroll and comparing offsets) means the toggle fires once
    // per boundary crossing rather than once per scroll event.
    const navWrap = document.querySelector<HTMLElement>('.nav-wrap')
    // The mobile panel is positioned inside the nav, so pinning the nav
    // re-anchors it and an open menu appears to teleport. Declared here and
    // filled in below, once setMenuOpen exists.
    let collapseMenu: (() => void) | null = null

    const hero = document.querySelector<HTMLElement>('.hero')

    if (navWrap && hero) {
      new IntersectionObserver(
        ([entry]) => {
          // `bottom < 0` guards the load-with-a-hash case: the hero can start
          // out below the viewport without meaning we scrolled past it.
          const stuck = !entry.isIntersecting && entry.boundingClientRect.bottom < 0
          navWrap.classList.toggle('is-stuck', stuck)
          // Safety net for the cases that skip the scroll tick: a hash jump
          // straight to the footer, or a resize that re-anchors the nav.
          if (stuck) collapseMenu?.()
        },
        { threshold: 0 },
      ).observe(hero)
    }

    // --- Mobile navigation -------------------------------------------------
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-button')
    const navLinks = document.querySelector<HTMLElement>('.nav-links')

    if (menuButton && navLinks) {
      const setMenuOpen = (open: boolean) => {
        menuButton.setAttribute('aria-expanded', String(open))
        menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú')
        navLinks.classList.toggle('is-open', open)
      }

      collapseMenu = () => setMenuOpen(false)

      menuButton.addEventListener('click', () => {
        setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true')
      })

      // Scrolling with the panel open dragged it along and then re-anchored it
      // to the stuck nav, so it popped into place with no transition. Collapse
      // on the first scroll tick instead: that lands well before the nav pins,
      // so the opacity/transform transition plays out while the panel is still
      // where the user opened it.
      window.addEventListener(
        'scroll',
        () => menuButton.getAttribute('aria-expanded') === 'true' && setMenuOpen(false),
        { passive: true },
      )

      navLinks.addEventListener('click', (event) => {
        if ((event.target as Element).closest('[data-nav-link]')) setMenuOpen(false)
      })

      // Collapse if the viewport grows past the CSS breakpoint while open.
      window
        .matchMedia('(min-width: 701px)')
        .addEventListener('change', (event) => event.matches && setMenuOpen(false))
    }

    // --- Service dialogs ---------------------------------------------------
    // Single source of truth for which dialog is up, so Escape does not need to
    // re-scan the DOM on every keypress.
    let openModal: HTMLElement | null = null
    let lastTrigger: HTMLElement | null = null
    // The exit animation is async, so a second Escape (or a fast reopen) would
    // otherwise hide the dialog mid-flight and strand the class on it. Every
    // close takes a token; bumping it orphans any settle still in the queue.
    let closeToken = 0
    let closingModal: HTMLElement | null = null
    // Set when a dialog is closed by one of its own in-page CTAs. The default
    // jump cannot be left to the browser: it would fire while the dialog is
    // still mounted and the body is scroll-locked, and the focus restore on
    // close would then scroll straight back up to the thumbnail.
    let pendingJump: HTMLElement | null = null

    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // The motes drift behind an almost-opaque veil where nobody can see them,
    // so the 30fps rAF loop is pure cost while a dialog is open.
    const syncParticles = (open: boolean) => {
      document.dispatchEvent(new CustomEvent('modal', { detail: { open } }))
    }

    const closeModal = () => {
      if (!openModal || closingModal) return
      const modal = openModal
      const token = ++closeToken
      closingModal = modal

      const settle = () => {
        if (token !== closeToken) return
        modal.classList.remove('is-closing')
        modal.hidden = true
        if (openModal === modal) openModal = null
        closingModal = null
        // A different dialog may already be up by now; whoever is last out owns
        // the scroll lock and the focus restore.
        if (!openModal) {
          document.body.style.removeProperty('overflow')
          // The jump, when there is one, replaces the focus restore: the
          // destination should own focus now, and focusing the thumbnail is
          // exactly what dragged the page back up.
          const jump = pendingJump
          pendingJump = null
          if (jump) {
            // The lock is off, so the scroll is allowed to stick this time.
            jump.scrollIntoView({
              behavior: prefersReducedMotion() ? 'auto' : 'smooth',
              block: 'start',
            })
            // Hand the keyboard to the destination without letting focus cause
            // a second, competing scroll.
            jump.setAttribute('tabindex', '-1')
            jump.focus({ preventScroll: true })
          } else {
            lastTrigger?.focus()
          }
          lastTrigger = null
          syncParticles(false)
        }
      }

      // Honour the OS setting: the animation is decoration, so with it off there
      // is nothing to wait for.
      if (prefersReducedMotion()) {
        settle()
        return
      }

      // `hidden` is display:none, which kills animations outright, so the exit
      // has to play on the still-visible dialog and only then unmount.
      modal.classList.add('is-closing')
      // The card's own animation ends first and bubbles up, so match on the
      // backdrop itself; the timer covers the case where it never fires.
      modal.addEventListener('animationend', (event) => event.target === modal && settle(), {
        once: true,
      })
      window.setTimeout(settle, 400)
    }

    const showModal = (modal: HTMLElement, trigger: HTMLElement) => {
      // `openModal` is single-slot, so a dialog left up from any earlier path
      // would become unreachable: Escape and the backdrop both route through
      // closeModal and would only ever close the tracked one. Enforce the
      // invariant instead of relying on the backdrop to prevent it.
      if (openModal && openModal !== modal) closeModal()
      // Reopening the dialog that is mid-exit: cancel that exit, or its pending
      // settle would slam it shut again a frame after it was shown.
      else if (closingModal === modal) {
        closeToken++
        closingModal = null
        modal.classList.remove('is-closing')
      }
      lastTrigger = trigger
      // A jump left over from a close that is still animating would fire behind
      // this dialog.
      pendingJump = null
      modal.hidden = false
      // Must run *after* the unhide: scrollTop is a silent no-op on a
      // display:none box, and the browser restores the previous offset once the
      // dialog is laid out again. Long lists would otherwise reopen mid-list.
      modal.querySelectorAll<HTMLElement>('[data-modal-scroll]').forEach((el) => (el.scrollTop = 0))
      openModal = modal
      document.body.style.overflow = 'hidden'
      modal.querySelector<HTMLElement>('[data-modal-close]')?.focus()
      syncParticles(true)
    }

    // Resolved once instead of per click: there are only a handful of dialogs,
    // but a querySelector on every open is pure waste on a hot path.
    const modals = new Map<string, HTMLElement>()
    document.querySelectorAll<HTMLElement>('[data-service-modal]').forEach((modal) => {
      modals.set(modal.dataset.serviceModal!, modal)
    })

    // The modal photos are `loading="lazy"` inside a display:none dialog, so
    // they stay out of the page load entirely. That means an open would stall
    // on a fetch. Hovering or tabbing onto a thumbnail is intent, so flip the
    // image to eager then -- by the time the click lands it is usually decoded.
    // Each dialog now holds a single photo, so this stays cheap; the two
    // siblings go along with it to keep the arrows instant.
    const warm = (modal: HTMLElement) => {
      const img = modal.querySelector<HTMLImageElement>('img[loading="lazy"]')
      if (!img) return
      img.loading = 'eager'
      img.decode?.().catch(() => {})
    }

    document.querySelectorAll<HTMLElement>('[data-service-trigger]').forEach((trigger) => {
      const key = trigger.dataset.serviceTrigger
      const modal = key ? modals.get(key) : undefined
      if (!modal) return

      trigger.addEventListener('pointerenter', () => warm(modal), { passive: true })
      trigger.addEventListener('focus', () => warm(modal))
      trigger.addEventListener('click', () => showModal(modal, trigger))
    })

    // Prev/next inside a category. `lastTrigger` is passed straight through so
    // closing still returns focus to the thumbnail that opened the gallery.
    // The arrows sitting inside the dialog being left.
    const modalStepTargets = (btn: HTMLElement) =>
      [...btn.closest<HTMLElement>('[data-service-modal]')!.querySelectorAll<HTMLElement>(
        '[data-modal-step]'
      )].map((s) => modals.get(s.dataset.modalStep!)).filter((m): m is HTMLElement => !!m)

    document.querySelectorAll<HTMLElement>('[data-modal-step]').forEach((btn) => {
      const key = btn.dataset.modalStep
      const target = key ? modals.get(key) : undefined
      if (!target) return

      btn.addEventListener('click', () => {
        warm(target)
        modalStepTargets(btn).forEach(warm)
        showModal(target, lastTrigger ?? btn)
      })
    })

    document.querySelectorAll<HTMLElement>('[data-service-modal]').forEach((modal) => {
      modal.addEventListener('click', (event) => {
        const target = event.target as Element
        // Close on backdrop click or on the close/CTA affordances. Clicks that
        // land inside the card are ignored.
if (target === modal || target.closest('[data-modal-close]')) closeModal()
    })

    // The "agendar este servicio" CTA inside a dialog. Handing the jump to
    // closeModal lets it happen once the dialog is out and the scroll lock is
    // released; letting the browser do it natively raced both of those and the
    // page ended up back where it started. Covers the price list too.
    document.querySelectorAll<HTMLAnchorElement>('[data-modal-close][href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const target = document.querySelector<HTMLElement>(link.getAttribute('href')!)
        if (!target) return
        event.preventDefault()
        // Nothing mounted means closeModal would bail out and leave the pending
        // jump to leak into the next dialog that closes.
        if (!openModal) {
          target.scrollIntoView({
            behavior: prefersReducedMotion() ? 'auto' : 'smooth',
            block: 'start',
          })
          return
        }
        pendingJump = target
        closeModal()
      })
    })
    })

    // The dialogs claim aria-modal, but the page behind is still focusable, so
    // Tab used to walk out of the open card and into the nav behind it.
    const FOCUSABLE =
      'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])'

    document.addEventListener('keydown', (event) => {
      if (!openModal) return

      if (event.key === 'Escape') {
        closeModal()
        return
      }

      if (event.key !== 'Tab') return
      const items = [...openModal.querySelectorAll<HTMLElement>(FOCUSABLE)].filter(
        (el) => el.offsetWidth || el.offsetHeight || el.getClientRects().length,
      )
      if (!items.length) return
      const first = items[0]
      const last = items[items.length - 1]
      const active = document.activeElement

      if (event.shiftKey && (active === first || !openModal.contains(active))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && active === last) {
        event.preventDefault()
        first.focus()
      }
    })

    // --- Booking form ------------------------------------------------------
    // Preserved as-is from the original: the form has no backend endpoint, so
    // submission is intercepted instead of navigating. Wire this to your
    // provider (Formspree, an Astro Action, ...) when one exists.
    document
      .querySelector<HTMLFormElement>('[data-booking-form]')
      ?.addEventListener('submit', (event) => event.preventDefault())
  </script>
</Layout>
