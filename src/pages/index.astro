---
import Layout from '@/layouts/Layout.astro'

import About from '@/components/About.astro'
import Booking from '@/components/Booking.astro'
import Footer from '@/components/Footer.astro'
import Hero from '@/components/Hero.astro'
import Intro from '@/components/Intro.astro'
import IntroLogo from '@/components/IntroLogo.astro'
import Location from '@/components/Location.astro'
import Nav from '@/components/Nav.astro'
import Prices from '@/components/Prices.astro'
import ServiceModal from '@/components/ServiceModal.astro'
import Services from '@/components/Services.astro'
---

<Layout
  title="Vanessa Ruales Studio | Beauty with intention"
  description="Un espacio para volver a ti. Servicios de hair styling, manicure y makeup en Popayán."
>
  <main class="site-shell">
    <Nav />
    <Hero />
    <Intro />
    <Services />
    <Prices />
    <About />
    <Location />
    <Booking />
    <Footer />
    <ServiceModal />
  </main>

  <IntroLogo />

  <!-- Decorative motes in the page gutters. pointer-events:none, and it stops
       itself under prefers-reduced-motion. -->
  <canvas data-particles aria-hidden="true"></canvas>

  <script src="../scripts/hero-rotator.ts"></script>
  <script src="../scripts/reveal.ts"></script>
  <script src="../scripts/particles.ts"></script>

  <script>
    // The page is static HTML; these are the only two interactive pieces and
    // neither needs a component framework, so nothing here ships React.

    // --- Logo intro ------------------------------------------------------
    // The overlay paints itself from CSS keyed on html.intro-pending. This only
    // tears it down: the timer guarantees the node leaves the DOM so it can
    // never keep intercepting clicks, and any deliberate input skips the rest.
    // Keep INTRO_MS in sync with the `animation` durations in IntroLogo.astro.
    const INTRO_MS = 1800
    const intro = document.querySelector<HTMLElement>('[data-intro]')

    if (intro) {
      const dismissIntro = () => {
        document.documentElement.classList.remove('intro-pending', 'intro-forced')
        intro.remove()
      }

      const introTimer = window.setTimeout(dismissIntro, INTRO_MS)
      for (const type of ['pointerdown', 'keydown', 'wheel']) {
        window.addEventListener(type, dismissIntro, {
          once: true,
          passive: true,
        })
      }
      window.addEventListener('pagehide', () => window.clearTimeout(introTimer))
    }

    // --- Sticky glass nav --------------------------------------------------
    // The nav is absolutely positioned over the hero so it scrolls away with it.
    // Once the hero is fully past the fold it has to stay reachable, so it
    // becomes fixed and grows the liquid-glass pill. Observing the hero (instead
    // of listening to scroll and comparing offsets) means the toggle fires once
    // per boundary crossing rather than once per scroll event.
    const navWrap = document.querySelector<HTMLElement>('.nav-wrap')
    const hero = document.querySelector<HTMLElement>('.hero')

    if (navWrap && hero) {
      new IntersectionObserver(
        ([entry]) => {
          // `bottom < 0` guards the load-with-a-hash case: the hero can start
          // out below the viewport without meaning we scrolled past it.
          navWrap.classList.toggle('is-stuck', !entry.isIntersecting && entry.boundingClientRect.bottom < 0)
        },
        { threshold: 0 },
      ).observe(hero)
    }

    // --- Mobile navigation -------------------------------------------------
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-button')
    const navLinks = document.querySelector<HTMLElement>('.nav-links')

    if (menuButton && navLinks) {
      const setMenuOpen = (open: boolean) => {
        menuButton.setAttribute('aria-expanded', String(open))
        menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú')
        navLinks.classList.toggle('is-open', open)
      }

      menuButton.addEventListener('click', () => {
        setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true')
      })

      navLinks.addEventListener('click', (event) => {
        if ((event.target as Element).closest('[data-nav-link]')) setMenuOpen(false)
      })

      // Collapse if the viewport grows past the CSS breakpoint while open.
      window
        .matchMedia('(min-width: 701px)')
        .addEventListener('change', (event) => event.matches && setMenuOpen(false))
    }

    // --- Service dialogs ---------------------------------------------------
    // Single source of truth for which dialog is up, so Escape does not need to
    // re-scan the DOM on every keypress.
    let openModal: HTMLElement | null = null
    let lastTrigger: HTMLElement | null = null

    // The motes drift behind an almost-opaque veil where nobody can see them,
    // so the 30fps rAF loop is pure cost while a dialog is open.
    const syncParticles = (open: boolean) => {
      document.dispatchEvent(new CustomEvent('modal', { detail: { open } }))
    }

    const closeModal = () => {
      if (!openModal) return
      openModal.hidden = true
      openModal = null
      document.body.style.removeProperty('overflow')
      lastTrigger?.focus()
      lastTrigger = null
      syncParticles(false)
    }

    const showModal = (modal: HTMLElement, trigger: HTMLElement) => {
      lastTrigger = trigger
      modal.hidden = false
      openModal = modal
      document.body.style.overflow = 'hidden'
      modal.querySelector<HTMLElement>('[data-modal-close]')?.focus()
      syncParticles(true)
    }

    // Resolved once instead of per click: there are only a handful of dialogs,
    // but a querySelector on every open is pure waste on a hot path.
    const modals = new Map<string, HTMLElement>()
    document.querySelectorAll<HTMLElement>('[data-service-modal]').forEach((modal) => {
      modals.set(modal.dataset.serviceModal!, modal)
    })

    // The modal photos are `loading="lazy"` inside a display:none dialog, so
    // they stay out of the page load entirely. That means an open would stall
    // on a ~50KB fetch. Hovering or tabbing onto a card is intent, so flip the
    // image to eager then -- by the time the click lands it is usually decoded,
    // and the shared width ladder means the card's own file is often reused.
    const warm = (modal: HTMLElement) => {
      modal
        .querySelectorAll<HTMLImageElement>('img[loading="lazy"]')
        .forEach((img) => {
          img.loading = 'eager'
          img.decode?.().catch(() => {})
        })
    }

    document.querySelectorAll<HTMLElement>('[data-service-trigger]').forEach((trigger) => {
      const key = trigger.dataset.serviceTrigger
      const modal = key ? modals.get(key) : undefined
      if (!modal) return

      trigger.addEventListener('pointerenter', () => warm(modal), { passive: true })
      trigger.addEventListener('focus', () => warm(modal))
      trigger.addEventListener('click', () => showModal(modal, trigger))
    })

    document.querySelectorAll<HTMLElement>('[data-service-modal]').forEach((modal) => {
      modal.addEventListener('click', (event) => {
        const target = event.target as Element
        // Close on backdrop click or on the close/CTA affordances. Clicks that
        // land inside the card are ignored.
        if (target === modal || target.closest('[data-modal-close]')) closeModal()
      })
    })

    // The dialogs claim aria-modal, but the page behind is still focusable, so
    // Tab used to walk out of the open card and into the nav behind it.
    const FOCUSABLE =
      'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])'

    document.addEventListener('keydown', (event) => {
      if (!openModal) return

      if (event.key === 'Escape') {
        closeModal()
        return
      }

      if (event.key !== 'Tab') return
      const items = [...openModal.querySelectorAll<HTMLElement>(FOCUSABLE)].filter(
        (el) => el.offsetWidth || el.offsetHeight || el.getClientRects().length,
      )
      if (!items.length) return
      const first = items[0]
      const last = items[items.length - 1]
      const active = document.activeElement

      if (event.shiftKey && (active === first || !openModal.contains(active))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && active === last) {
        event.preventDefault()
        first.focus()
      }
    })

    // --- Booking form ------------------------------------------------------
    // Preserved as-is from the original: the form has no backend endpoint, so
    // submission is intercepted instead of navigating. Wire this to your
    // provider (Formspree, an Astro Action, ...) when one exists.
    document
      .querySelector<HTMLFormElement>('[data-booking-form]')
      ?.addEventListener('submit', (event) => event.preventDefault())
  </script>
</Layout>
